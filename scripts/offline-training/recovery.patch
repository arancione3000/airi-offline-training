+from generalist_lm.training import SFTExample, train_sft
+
+def model(context=128):
+    torch.manual_seed(11)
+    return CausalTransformerLM(GeneralistLMConfig(context_length=context,d_model=32,n_heads=4,n_layers=1,d_ff=64))
+
+def row(prompt='Hi',answer='Hello'):
+    return SFTExample([{'role':'user','content':prompt},{'role':'assistant','content':answer}])
+
+def test_zero_weight_preserves_exact_updates_and_sampling():
+    a=model();b=copy.deepcopy(a);t=ByteTokenizer();rows=[row(),row('Ciao','Salve')]
+    original=train_sft(a,t,rows,steps=2,batch_size=2,gradient_accumulation_steps=2)
+    zero=train_sft(b,t,rows,steps=2,batch_size=2,gradient_accumulation_steps=2,reference_model=b,reference_kl_weight=0)
+    assert all(torch.equal(v,b.state_dict()[k]) for k,v in a.state_dict().items())
+    assert original['supervised_tokens']==zero['supervised_tokens']
+    assert zero['reference_tokens']==0
+
+def test_reference_frozen_and_receives_only_separate_short_anchors(monkeypatch):
+    a=model(128);teacher=model(64);t=ByteTokenizer();anchor=row('Keep','Safe')
+    before={k:v.clone() for k,v in teacher.state_dict().items()}
+    seen=[];forward=teacher.forward
+    def observe(ids,*args,**kwargs):
+        assert not torch.is_grad_enabled()
+        assert not teacher.training
+        assert ids.shape[1]==64
+        seen.extend(t.decode(x.tolist()) for x in ids)
+        return forward(ids,*args,**kwargs)
+    monkeypatch.setattr(teacher,'forward',observe)
+    stats=train_sft(a,t,[row('New question','New lesson')],steps=2,batch_size=2,gradient_accumulation_steps=2,reference_model=teacher,reference_kl_weight=1,reference_examples=[anchor],require_complete_examples=True)
+    assert seen and all('Keep' in text and 'New question' not in text for text in seen)
+    assert all(torch.equal(before[k],v) for k,v in teacher.state_dict().items())
+    assert all(p.grad is None for p in teacher.parameters())
+    assert stats['reference_scope']=='anchors'
+    assert stats['supervised_tokens']==8*len(t.encode('New lesson',eos=True))
+    assert stats['reference_tokens']==8*len(t.encode('Safe',eos=True))
+
+@pytest.mark.parametrize('weight',[-1,float('nan'),float('inf')])
+def test_invalid_weight_rejected_before_mutation(monkeypatch,weight):
+    a=model();monkeypatch.setattr(a,'to',lambda *args,**kwargs:pytest.fail('model moved'))
+    with pytest.raises(ValueError,match='finite and nonnegative'):
+        train_sft(a,ByteTokenizer(),[row()],reference_kl_weight=weight)
+
+def test_shared_parameter_storage_rejected():
+    a=model();b=copy.deepcopy(a);b.token_embedding.weight=a.token_embedding.weight
+    with pytest.raises(ValueError,match='share parameter storage'):
+        train_sft(a,ByteTokenizer(),[row()],reference_model=b,reference_kl_weight=1)
+
+def test_missing_reference_rejected():
+    with pytest.raises(ValueError,match='independent reference'):
+        train_sft(model(),ByteTokenizer(),[row()],reference_kl_weight=1)
+
+@pytest.mark.parametrize('anchors',[[],[row('x'*100,'answer')]])
+def test_invalid_anchors_preflight_before_either_model_moves(monkeypatch,anchors):
+    a=model();b=model(64)
+    for m in [a,b]:monkeypatch.setattr(m,'to',lambda *args,**kwargs:pytest.fail('model moved'))
+    with pytest.raises(ValueError,match='reference example'):
+        train_sft(a,ByteTokenizer(),[row()],reference_model=b,reference_kl_weight=1,reference_examples=anchors)
+
+def test_legacy_same_batch_reference_path_is_masked_and_finite():
+    a=model();b=copy.deepcopy(a);t=ByteTokenizer()
+    result=train_sft(a,t,[row()],steps=2,reference_model=b,reference_kl_weight=1)
+    assert result['reference_scope']=='sft_batch'
+    assert result['reference_kl_loss_mean']>=0
+    assert result['reference_tokens']==result['supervised_tokens']
