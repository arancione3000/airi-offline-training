index 0000000..102efdd
--- /dev/null
+++ b/tests/test_generalist_context_memory.py
@@ -0,0 +1,45 @@
+import pytest
+torch = pytest.importorskip('torch')
+from generalist_lm.model import CausalTransformerLM, GeneralistLMConfig
+from generalist_lm.tokenizer import ByteTokenizer
+from generalist_lm.training import SFTExample, _batch, nll_stats_on_examples
+from generalist_lm.curriculum import train_rows
+from generalist_lm.research_cycle import _teacher_forced_accuracy
+
+def model():
+    torch.manual_seed(42)
+    return CausalTransformerLM(GeneralistLMConfig(context_length=128, d_model=32, n_heads=4, n_layers=1, d_ff=64)).eval()
+
+def test_nll_bounded_batches_preserve_dense_token_and_byte_scores(monkeypatch):
+    m=model(); t=ByteTokenizer()
+    rows=[SFTExample([{'role':'user','content':'Question?'},{'role':'assistant','content':'Caffè '+str(i)}]) for i in range(11)]
+    ids,labels=_batch(rows,t,128,range(len(rows)))
+    with torch.no_grad():
+        logits=m(ids)['logits'][:,:-1,:]
+        expected=torch.nn.functional.cross_entropy(logits.reshape(-1,logits.shape[-1]),labels[:,1:].reshape(-1),ignore_index=-100,reduction='sum').item()
+    shapes=[]; forward=m.forward
+    def record(ids,*args,**kwargs):
+        shapes.append(tuple(ids.shape)); return forward(ids,*args,**kwargs)
+    monkeypatch.setattr(m,'forward',record)
+    stats=nll_stats_on_examples(m,t,rows,batch_size=2)
+    assert stats['total_nll']==pytest.approx(expected,rel=1e-6)
+    assert stats['target_tokens']==int((labels[:,1:]!=-100).sum())
+    assert stats['target_bytes']==sum(len(r.messages[-1]['content'].encode()) for r in rows)
+    assert max(b for b,_ in shapes)<=2
+    assert max(n for _,n in shapes)<128
+
+def test_teacher_accuracy_preserves_dense_scores_and_limits_batch(monkeypatch):
+    m=model();t=ByteTokenizer();rows=train_rows()[:19]
+    ids,labels=_batch([r.sft() for r in rows],t,128,range(len(rows)))
+    with torch.no_grad():
+        predicted=m(ids)['logits'][:,:-1,:].argmax(-1)
+    valid=labels[:,1:]!=-100
+    expected=float(((predicted==labels[:,1:])&valid).sum()/valid.sum())
+    shapes=[];forward=m.forward
+    def record(ids,*args,**kwargs):
+        shapes.append(tuple(ids.shape));return forward(ids,*args,**kwargs)
+    monkeypatch.setattr(m,'forward',record)
+    stats=_teacher_forced_accuracy(m,t,rows,device='cpu')
+    assert stats['target_token_accuracy']==pytest.approx(expected)
+    assert stats['target_tokens']==int(valid.sum())
+    assert max(b for b,_ in shapes)<=8
diff --git a/tests/test_generalist_sft_encoding.py b/tests/test_generalist_sft_encoding.py
new file mode 100644
index 0000000..a068f47
--- /dev/null
+++ b/tests/test_generalist_sft_encoding.py
@@ -0,0 +1,97 @@
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from generalist_lm.bpe_tokenizer import train_bpe
+from generalist_lm.model import CausalTransformerLM, GeneralistLMConfig
+from generalist_lm.tokenizer import ASSISTANT, EOS, PAD, ByteTokenizer
+from generalist_lm.training import SFTExample, encode_sft_example, train_sft
+
+
+@pytest.fixture(params=["byte", "bpe"])
+def tokenizer(request):
+    if request.param == "byte":
+        return ByteTokenizer()
+    return train_bpe(["Caffè 🌸 grazie! " * 10], vocab_size=280)
+
+
+def example(answer="Caffè 🌸 grazie!"):
+    return SFTExample([
+        {"role": "system", "content": "Rispondi brevemente."},
+        {"role": "user", "content": "Cosa bevi?"},
+        {"role": "assistant", "content": "Tè."},
+        {"role": "user", "content": "E ora?"},
+        {"role": "assistant", "content": answer},
+    ])
+
+
+@pytest.mark.parametrize("padding", [0, 17])
+def test_complete_encoding_preserves_all_turns_utf8_and_eos(tokenizer, padding):
+    row = example()
+    prompt = tokenizer.serialize_messages(row.messages[:-1], add_generation_prompt=True)
+    target = tokenizer.encode(row.messages[-1]["content"], eos=True)
+    context = len(prompt) + len(target) + padding
+    ids, labels = encode_sft_example(row, tokenizer, context, require_complete=True)
+    legacy = encode_sft_example(row, tokenizer, context)
+    assert torch.equal(ids, legacy[0])
+    assert torch.equal(labels, legacy[1])
+    assert ids.tolist() == prompt + target + [PAD] * padding
+    assert labels.tolist() == [-100] * len(prompt) + target + [-100] * padding
+    assert prompt[-1] == ASSISTANT
+    assert target[-1] == EOS
+    assert tokenizer.decode(target) == row.messages[-1]["content"]
+
+
+@pytest.mark.parametrize("part", ["prompt", "answer"])
+def test_complete_encoding_rejects_overflow_without_fabricating_eos(tokenizer, part):
+    row = example("x" * 400 if part == "answer" else "Va bene.")
+    if part == "prompt":
+        row.messages[-2]["content"] = "Domanda lunga " * 100
+    with pytest.raises(ValueError, match="complete SFT example exceeds context"):
+        encode_sft_example(row, tokenizer, 128, require_complete=True)
+    # Existing evaluation encoding remains the historical target-first policy.
+    prompt = tokenizer.serialize_messages(row.messages[:-1], add_generation_prompt=True)
+    target = tokenizer.encode(row.messages[-1]["content"], eos=True)[:127]
+    prompt = prompt[-max(1, 128 - len(target)):]
+    ids, labels = encode_sft_example(row, tokenizer, 128)
+    assert ids[:len(prompt) + len(target)].tolist() == prompt + target
+    assert labels[:len(prompt)].tolist() == [-100] * len(prompt)
+    assert labels[len(prompt):len(prompt) + len(target)].tolist() == target
+
+
+def test_training_preflights_every_row_before_any_model_mutation(monkeypatch):
+    tokenizer = ByteTokenizer()
+    model = CausalTransformerLM(GeneralistLMConfig(
+        context_length=128, d_model=32, n_heads=4, n_layers=1, d_ff=64,
+    ))
+    before = {k: v.clone() for k, v in model.state_dict().items()}
+    def forbidden(*args, **kwargs):
+        pytest.fail("model was touched before corpus validation completed")
+    monkeypatch.setattr(model, "to", forbidden)
+    with pytest.raises(ValueError, match="SFT example 1: complete SFT example"):
+        train_sft(model, tokenizer, [example(), example("x" * 400)],
+                  steps=1, require_complete_examples=True)
+    assert all(torch.equal(before[k], v) for k, v in model.state_dict().items())
+
+
+def test_complete_encoding_handles_minimum_context_and_empty_response(tokenizer):
+    row = SFTExample([{"role": "assistant", "content": ""}])
+    ids, labels = encode_sft_example(row, tokenizer, 3, require_complete=True)
+    assert ids.tolist() == [1, ASSISTANT, EOS]
+    assert labels.tolist() == [-100, -100, EOS]
+    with pytest.raises(ValueError, match="exceeds context"):
+        encode_sft_example(row, tokenizer, 2, require_complete=True)
+
+
+def test_complete_training_smoke_reports_only_real_supervised_tokens():
+    tokenizer = ByteTokenizer()
+    model = CausalTransformerLM(GeneralistLMConfig(
+        context_length=128, d_model=32, n_heads=4, n_layers=1, d_ff=64,
+    ))
+    row = example()
+    result = train_sft(model, tokenizer, [row], steps=2, batch_size=1,
+                       require_complete_examples=True)
+    assert result["require_complete_examples"] is True
+    assert result["supervised_tokens"] == 2 * len(tokenizer.encode(
+        row.messages[-1]["content"], eos=True))
+    assert torch.isfinite(torch.tensor(result["final_loss"]))
